# Settings for soulseek_batch.py. Command-line options override these values.
# Every key carries its unit (_s = seconds, _min = minutes).
#
# Only these four keys live here, because only these four are used by THIS script.
# Everything else is sockseek's own business and belongs in sockseek.conf, next to the
# login: search limiter, stale time, formats, fast-search, desperate and the rest.
# For a one-off experiment pass flags straight through, e.g.
#   py run.py --only mylist --sockseek-args="--desperate --artist-maybe-wrong"
[settings]
# Length tolerance in seconds around the length written in the playlist.
# HARD condition: files outside the window are rejected. -1 disables the filter.
#
# 45, not 3, since 2026-10-07. Measured that day: the lengths in a SoundCloud playlist are
# systematically SHORTER than the copies people share (319 s in the list, 346 s on the
# network for the same remix), so a 3 s window rejects the very file you asked for. What
# keeps another version of the song out is not this number but the search itself: Soulseek
# requires every word of the query to appear in the file path, so a query carrying
# "(Club Calimari Remix)" cannot match the plain original.
length_tol_s = 45
# Attempts per playlist (at least 1). A retry only searches what is still missing,
# and it earns tracks: on run #0002 a sharer that timed out on the first attempt
# delivered the file on the second.
retries = 2
# Wall-clock limit for one attempt at one playlist, in MINUTES. 0 = none.
# 90 since 2026-10-08: with max-stale-time at 5 minutes (sockseek.conf) a run that waits in
# several uploaders' queues can legitimately take much longer than the 6 minutes a plain run
# takes. The built-in default stays 40 for a tool used without this ini.
playlist_timeout_min = 90
# ffprobe.exe for the length check after each playlist (report only, changes nothing).
# Empty = auto: ffprobe on PATH, then C:\ffmpeg\bin\ffprobe.exe.
ffprobe_path =
